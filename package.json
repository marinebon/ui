{
  "name": "@marinebon/ui",
  "version": "0.1.0",
  "description": "MBON UI kit: brand tokens and Svelte components for MBON web apps",
  "license": "MIT",
  "author": "Ocean Metrics LLC (https://oceanmetrics.io)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marinebon/ui.git"
  },
  "homepage": "https://marinebon.org/ui/",
  "type": "module",
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./theme": {
      "types": "./dist/theme.d.ts",
      "default": "./dist/theme.js"
    },
    "./styles.css": "./dist/styles.css",
    "./tokens.css": "./dist/tokens.css",
    "./base.css": "./dist/base.css",
    "./fonts.css": "./dist/fonts.css",
    "./fonts/*": "./dist/fonts/*",
    "./img/*": "./dist/img/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "AGENTS.md",
    "NEWS.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run package && npm run build:demo",
    "package": "svelte-package -i src/lib -o dist && publint --strict",
    "build:demo": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "screenshots": "vite build && node scripts/screenshots.mjs"
  },
  "devDependencies": {
    "@sveltejs/package": "^3.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "@testing-library/user-event": "^14.6.7",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^24.19.1",
    "jsdom": "^29.1.1",
    "playwright": "^1.63.0",
    "publint": "^0.3.25",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "typescript": "~6.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
